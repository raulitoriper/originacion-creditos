<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_CreditOrigination"
                  targetNamespace="http://camunda.org/schema/1.0/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.28.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.7.0">

  <bpmn:message id="Message_SignatureCompleted" name="SignatureCompleted">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=applicationId" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmn:error id="Error_DisbursementFailed" name="DisbursementFailed" errorCode="DISBURSEMENT_FAILED" />

  <bpmn:process id="credit-origination" name="Originacion de creditos" isExecutable="true">

    <!-- ============ Camino principal ============ -->

    <bpmn:startEvent id="StartEvent_Submitted" name="Solicitud recibida">
      <bpmn:outgoing>Flow_Start_Bureau</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Activity_QueryBureau" name="Consultar bureau de credito">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-credit-bureau" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Bureau</bpmn:incoming>
      <bpmn:outgoing>Flow_Bureau_Score</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Activity_ScoreApplicant" name="Evaluar politica de riesgo (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="credit_scoring" resultVariable="riskDecision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Bureau_Score</bpmn:incoming>
      <bpmn:outgoing>Flow_Score_Decision</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_RiskDecision" name="Resultado del scoring" default="Flow_Decision_Reject">
      <bpmn:incoming>Flow_Score_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_Review</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_RiskJoin">
      <bpmn:incoming>Flow_Decision_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_Review_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Signature</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:eventBasedGateway id="Gateway_AwaitSignature" name="Firma o vencimiento">
      <bpmn:incoming>Flow_Join_Signature</bpmn:incoming>
      <bpmn:outgoing>Flow_Signature_Received</bpmn:outgoing>
      <bpmn:outgoing>Flow_Signature_Expired</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_SignatureReceived" name="Firma digital recibida">
      <bpmn:incoming>Flow_Signature_Received</bpmn:incoming>
      <bpmn:outgoing>Flow_Signed_Reserve</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Signature" messageRef="Message_SignatureCompleted" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Event_SignatureExpired" name="Vencio el plazo de firma">
      <bpmn:incoming>Flow_Signature_Expired</bpmn:incoming>
      <bpmn:outgoing>Flow_Expired_End</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Signature">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndEvent_SignatureExpired" name="Oferta vencida">
      <bpmn:incoming>Flow_Expired_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Activity_ReserveFunds" name="Reservar fondos">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reserve-funds" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Signed_Reserve</bpmn:incoming>
      <bpmn:outgoing>Flow_Reserve_Disburse</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="Boundary_ReserveCompensation" name="Compensar reserva" attachedToRef="Activity_ReserveFunds">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_Reserve" />
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Activity_ReleaseFunds" name="Liberar fondos reservados" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-funds" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Activity_DisburseLoan" name="Desembolsar prestamo">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="disburse-loan" retries="1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reserve_Disburse</bpmn:incoming>
      <bpmn:outgoing>Flow_Disburse_Notify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="Boundary_DisbursementFailed" name="Desembolso rechazado" attachedToRef="Activity_DisburseLoan">
      <bpmn:outgoing>Flow_Failed_Compensate</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Disbursement" errorRef="Error_DisbursementFailed" />
    </bpmn:boundaryEvent>

    <bpmn:intermediateThrowEvent id="Event_CompensateOrigination" name="Compensar originacion">
      <bpmn:incoming>Flow_Failed_Compensate</bpmn:incoming>
      <bpmn:outgoing>Flow_Compensate_End</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_Throw" />
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="EndEvent_DisbursementFailed" name="Originacion revertida">
      <bpmn:incoming>Flow_Compensate_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Activity_NotifyApproval" name="Notificar aprobacion">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-applicant" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;APPROVAL&#34;" target="template" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Disburse_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Disbursed" name="Credito desembolsado">
      <bpmn:incoming>Flow_Notify_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ============ Revision manual + SLA ============ -->

    <bpmn:userTask id="Activity_ManualReview" name="Revision manual del analista">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="analistas-riesgo" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decision_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Outcome</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Boundary_ReviewSla" name="4 h sin resolver" cancelActivity="false" attachedToRef="Activity_ManualReview">
      <bpmn:outgoing>Flow_Sla_Escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Sla">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Activity_EscalateReview" name="Escalar al supervisor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="escalate-review" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Sla_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Escalated" name="Supervisor notificado">
      <bpmn:incoming>Flow_Escalate_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_ReviewOutcome" name="Decision del analista" default="Flow_Review_Rejected">
      <bpmn:incoming>Flow_Review_Outcome</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Review_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ============ Rechazo ============ -->

    <bpmn:serviceTask id="Activity_NotifyRejection" name="Notificar rechazo">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-applicant" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;REJECTION&#34;" target="template" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decision_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_Review_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_Rejection_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Rejected" name="Solicitud rechazada">
      <bpmn:incoming>Flow_Rejection_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ============ Flujos ============ -->

    <bpmn:sequenceFlow id="Flow_Start_Bureau" sourceRef="StartEvent_Submitted" targetRef="Activity_QueryBureau" />
    <bpmn:sequenceFlow id="Flow_Bureau_Score" sourceRef="Activity_QueryBureau" targetRef="Activity_ScoreApplicant" />
    <bpmn:sequenceFlow id="Flow_Score_Decision" sourceRef="Activity_ScoreApplicant" targetRef="Gateway_RiskDecision" />

    <bpmn:sequenceFlow id="Flow_Decision_Approved" name="APPROVED" sourceRef="Gateway_RiskDecision" targetRef="Gateway_RiskJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decision_Review" name="MANUAL_REVIEW" sourceRef="Gateway_RiskDecision" targetRef="Activity_ManualReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskDecision = "MANUAL_REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decision_Reject" name="REJECTED" sourceRef="Gateway_RiskDecision" targetRef="Activity_NotifyRejection" />

    <bpmn:sequenceFlow id="Flow_Review_Outcome" sourceRef="Activity_ManualReview" targetRef="Gateway_ReviewOutcome" />
    <bpmn:sequenceFlow id="Flow_Review_Approved" name="aprueba" sourceRef="Gateway_ReviewOutcome" targetRef="Gateway_RiskJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Review_Rejected" name="rechaza" sourceRef="Gateway_ReviewOutcome" targetRef="Activity_NotifyRejection" />

    <bpmn:sequenceFlow id="Flow_Sla_Escalate" sourceRef="Boundary_ReviewSla" targetRef="Activity_EscalateReview" />
    <bpmn:sequenceFlow id="Flow_Escalate_End" sourceRef="Activity_EscalateReview" targetRef="EndEvent_Escalated" />
    <bpmn:sequenceFlow id="Flow_Rejection_End" sourceRef="Activity_NotifyRejection" targetRef="EndEvent_Rejected" />

    <bpmn:sequenceFlow id="Flow_Join_Signature" sourceRef="Gateway_RiskJoin" targetRef="Gateway_AwaitSignature" />
    <bpmn:sequenceFlow id="Flow_Signature_Received" sourceRef="Gateway_AwaitSignature" targetRef="Event_SignatureReceived" />
    <bpmn:sequenceFlow id="Flow_Signature_Expired" sourceRef="Gateway_AwaitSignature" targetRef="Event_SignatureExpired" />
    <bpmn:sequenceFlow id="Flow_Expired_End" sourceRef="Event_SignatureExpired" targetRef="EndEvent_SignatureExpired" />
    <bpmn:sequenceFlow id="Flow_Signed_Reserve" sourceRef="Event_SignatureReceived" targetRef="Activity_ReserveFunds" />
    <bpmn:sequenceFlow id="Flow_Reserve_Disburse" sourceRef="Activity_ReserveFunds" targetRef="Activity_DisburseLoan" />
    <bpmn:sequenceFlow id="Flow_Disburse_Notify" sourceRef="Activity_DisburseLoan" targetRef="Activity_NotifyApproval" />
    <bpmn:sequenceFlow id="Flow_Notify_End" sourceRef="Activity_NotifyApproval" targetRef="EndEvent_Disbursed" />
    <bpmn:sequenceFlow id="Flow_Failed_Compensate" sourceRef="Boundary_DisbursementFailed" targetRef="Event_CompensateOrigination" />
    <bpmn:sequenceFlow id="Flow_Compensate_End" sourceRef="Event_CompensateOrigination" targetRef="EndEvent_DisbursementFailed" />

    <bpmn:association id="Association_ReleaseFunds" associationDirection="One"
                      sourceRef="Boundary_ReserveCompensation" targetRef="Activity_ReleaseFunds" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="credit-origination">

      <bpmndi:BPMNShape id="Shape_StartEvent_Submitted" bpmnElement="StartEvent_Submitted">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="132" y="225" width="79" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_QueryBureau" bpmnElement="Activity_QueryBureau">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_ScoreApplicant" bpmnElement="Activity_ScoreApplicant">
        <dc:Bounds x="390" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_RiskDecision" bpmnElement="Gateway_RiskDecision" isMarkerVisible="true">
        <dc:Bounds x="545" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="527" y="132" width="87" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_RiskJoin" bpmnElement="Gateway_RiskJoin" isMarkerVisible="true">
        <dc:Bounds x="890" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_AwaitSignature" bpmnElement="Gateway_AwaitSignature">
        <dc:Bounds x="990" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="972" y="132" width="87" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_SignatureReceived" bpmnElement="Event_SignatureReceived">
        <dc:Bounds x="1092" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1072" y="142" width="79" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_SignatureExpired" bpmnElement="Event_SignatureExpired">
        <dc:Bounds x="1092" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1068" y="355" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_SignatureExpired" bpmnElement="EndEvent_SignatureExpired">
        <dc:Bounds x="1182" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1170" y="288" width="61" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_ReserveFunds" bpmnElement="Activity_ReserveFunds">
        <dc:Bounds x="1180" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_DisburseLoan" bpmnElement="Activity_DisburseLoan">
        <dc:Bounds x="1330" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_NotifyApproval" bpmnElement="Activity_NotifyApproval">
        <dc:Bounds x="1480" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Disbursed" bpmnElement="EndEvent_Disbursed">
        <dc:Bounds x="1632" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1610" y="225" width="81" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_ReleaseFunds" bpmnElement="Activity_ReleaseFunds">
        <dc:Bounds x="1180" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_CompensateOrigination" bpmnElement="Event_CompensateOrigination">
        <dc:Bounds x="1362" y="340" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1340" y="383" width="81" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_DisbursementFailed" bpmnElement="EndEvent_DisbursementFailed">
        <dc:Bounds x="1462" y="340" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1438" y="383" width="86" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_ManualReview" bpmnElement="Activity_ManualReview">
        <dc:Bounds x="620" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ReviewOutcome" bpmnElement="Gateway_ReviewOutcome" isMarkerVisible="true">
        <dc:Bounds x="790" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="772" y="275" width="87" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_EscalateReview" bpmnElement="Activity_EscalateReview">
        <dc:Bounds x="590" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Escalated" bpmnElement="EndEvent_Escalated">
        <dc:Bounds x="722" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="700" y="485" width="82" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_NotifyRejection" bpmnElement="Activity_NotifyRejection">
        <dc:Bounds x="500" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Rejected" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="652" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="630" y="625" width="81" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Boundary_ReviewSla" bpmnElement="Boundary_ReviewSla">
        <dc:Bounds x="652" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="692" y="386" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_ReserveCompensation" bpmnElement="Boundary_ReserveCompensation">
        <dc:Bounds x="1212" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1252" y="256" width="83" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_DisbursementFailed" bpmnElement="Boundary_DisbursementFailed">
        <dc:Bounds x="1362" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1402" y="256" width="94" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_Start_Bureau" bpmnElement="Flow_Start_Bureau">
        <di:waypoint x="188" y="200" /><di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Bureau_Score" bpmnElement="Flow_Bureau_Score">
        <di:waypoint x="340" y="200" /><di:waypoint x="390" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Score_Decision" bpmnElement="Flow_Score_Decision">
        <di:waypoint x="490" y="200" /><di:waypoint x="545" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Decision_Approved" bpmnElement="Flow_Decision_Approved">
        <di:waypoint x="595" y="200" /><di:waypoint x="890" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="608" y="176" width="65" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Decision_Review" bpmnElement="Flow_Decision_Review">
        <di:waypoint x="570" y="225" /><di:waypoint x="570" y="330" /><di:waypoint x="620" y="330" />
        <bpmndi:BPMNLabel><dc:Bounds x="576" y="296" width="95" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Decision_Reject" bpmnElement="Flow_Decision_Reject">
        <di:waypoint x="570" y="225" /><di:waypoint x="570" y="260" /><di:waypoint x="450" y="260" />
        <di:waypoint x="450" y="600" /><di:waypoint x="500" y="600" />
        <bpmndi:BPMNLabel><dc:Bounds x="456" y="236" width="64" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Review_Outcome" bpmnElement="Flow_Review_Outcome">
        <di:waypoint x="720" y="330" /><di:waypoint x="790" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Review_Approved" bpmnElement="Flow_Review_Approved">
        <di:waypoint x="840" y="330" /><di:waypoint x="915" y="330" /><di:waypoint x="915" y="225" />
        <bpmndi:BPMNLabel><dc:Bounds x="851" y="306" width="46" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Review_Rejected" bpmnElement="Flow_Review_Rejected">
        <di:waypoint x="815" y="355" /><di:waypoint x="815" y="520" /><di:waypoint x="550" y="520" />
        <di:waypoint x="550" y="560" />
        <bpmndi:BPMNLabel><dc:Bounds x="821" y="430" width="45" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
