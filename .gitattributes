# Normalizar a LF en el repo y en el working tree.
# Sin esto, clonar en Windows reescribe los .bpmn y .dmn con CRLF y cualquier
# diff del modelo aparece como el archivo entero cambiado.
* text=auto eol=lf

*.bpmn text eol=lf
*.dmn  text eol=lf
*.sql  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf
